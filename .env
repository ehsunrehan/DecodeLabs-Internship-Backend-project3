# --- HTTP ---
PORT=5103
NODE_ENV=development

# --- JWT ---
# In production this must be a long random string kept out of git.
JWT_SECRET=decodelabs-batch-2026-signing-key-change-me
JWT_EXPIRES_IN=30m
JWT_ISSUER=decodelabs.auth

# --- Password hashing ---
BCRYPT_ROUNDS=10

# --- Login rate limit ---
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MS=600000
